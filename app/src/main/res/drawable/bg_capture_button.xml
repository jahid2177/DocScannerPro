<?xml version="1.0" encoding="utf-8"?>
<!-- Premium two-ring shutter button (default / searching state). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="2.5dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item android:top="6dp" android:bottom="6dp" android:start="6dp" android:end="6dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
            <stroke android:width="3.5dp" android:color="@color/brand_blue" />
        </shape>
    </item>
</layer-list>
