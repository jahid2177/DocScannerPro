<?xml version="1.0" encoding="utf-8"?>
<!-- Shutter button "ready" state: shown once the detected page is stable and
     auto-capture is about to fire, so the teal ring gives a clear pre-shutter cue. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="2.5dp" android:color="#802979FF" />
        </shape>
    </item>
    <item android:top="6dp" android:bottom="6dp" android:start="6dp" android:end="6dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
            <stroke android:width="3.5dp" android:color="@color/accent_teal" />
        </shape>
    </item>
</layer-list>
